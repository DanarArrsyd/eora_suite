{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "eora/api",
    "type": "project",
    "description": "EORA Suite API \u2014 Laravel modular monolith (B0 foundation).",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "laravel/framework": "^13.33",
        "laravel/sanctum": "^4.3.3",
        "laravel/tinker": "^3.0",
        "league/flysystem-aws-s3-v3": "^3.35.3",
        "openspout/openspout": "^5.12.2",
        "predis/predis": "^3.6"
    },
    "require-dev": {
        "dedoc/scramble": "^0.13.45",
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.12",
        "laravel/pail": "^1.2.5",
        "laravel/pint": "^1.32",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^5.2",
        "pestphp/pest-plugin-laravel": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "format": "pint",
        "format:check": "pint --test",
        "analyse": "phpstan analyse --memory-limit=1G",
        "test": [
            "@php artisan config:clear --ansi",
            "pest"
        ],
        "test:unit": [
            "@php artisan config:clear --ansi",
            "pest --exclude-group=integration"
        ],
        "openapi:export": "APP_URL=http://localhost:8000 php artisan scramble:export --path=../../packages/api-client/openapi.json",
        "check": [
            "@format:check",
            "@analyse",
            "@test"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "8.4.12"
        },
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
