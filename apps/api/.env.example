# EORA Suite API — local development template. Copy to .env (gitignored) and fill the secrets.
# Never commit real credentials; production values come from the secrets manager (doc 05).
APP_NAME="EORA Suite API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Structured JSON logs on stderr (use LOG_STACK=single for a local text file instead)
LOG_CHANNEL=stack
LOG_STACK=json
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL (Docker Compose service "postgres" publishes 5432 on the host)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=eora
# Runtime role (doc 25 §5.1) — never the bootstrap superuser. Passwords = the EORA_DB_*_PASSWORD values in the root .env.
DB_USERNAME=eora_app
DB_PASSWORD=
# Migrations owner: php artisan migrate --database=pgsql_owner
DB_OWNER_USERNAME=eora_owner
DB_OWNER_PASSWORD=
# Tenant provisioning role (doc 25 §2.5)
DB_PROVISIONER_PASSWORD=
# Auth roles (doc 25 §2.1): web authentication and the separate secret-delivery worker
DB_AUTH_WEB_PASSWORD=
DB_AUTH_DELIVERY_PASSWORD=

# Signed tenant context (D-055): key id and 64-hex key, identical to EORA_CTX_KEY_KID1 in the root .env
EORA_CTX_SIGNING_KID=kid1
EORA_CTX_SIGNING_KEY=
# Pepper for keyed hashes in security events (D-B1-22), = EORA_PEPPER_KEY in the root .env
EORA_PEPPER_KEY=
DB_CONNECT_TIMEOUT=3

# Redis via predis (no PHP extension needed). Docker Compose publishes Redis on host port 6380
# to avoid clashing with a locally installed Redis on 6379.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6380
REDIS_TIMEOUT=2

CACHE_STORE=redis
QUEUE_CONNECTION=redis
# Sessions (ADR-0006, D-B1-05): Redis, __Host- cookie (Secure + Path=/ + no Domain), idle 30 min, SameSite=Lax
SESSION_DRIVER=redis
SESSION_COOKIE=__Host-eora_session
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_LIFETIME=30
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,localhost:3100,127.0.0.1,127.0.0.1:3000,127.0.0.1:3100
EORA_FRONTEND_URL=http://localhost:3100
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# The invitation worker refuses the log/array mailers outside tests (they would store one-time secrets).
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_FROM_ADDRESS=no-reply@eora.local
