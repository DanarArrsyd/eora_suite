# Docker Compose variables for local development (copy to .env — gitignored — and fill in).
# These are LOCAL-ONLY values; never reuse them anywhere else.
EORA_DB_DATABASE=eora
# Bootstrap superuser: used only by the db-bootstrap service (creates roles/schemas), never by the API.
EORA_DB_USERNAME=eora
EORA_DB_PASSWORD=
# Role passwords (doc 25 §5.1): >= 24 chars of [A-Za-z0-9_-]. `sh scripts/ensure-dev-secrets.sh` fills missing ones.
EORA_DB_OWNER_PASSWORD=
EORA_DB_APP_PASSWORD=
EORA_DB_AUTH_WEB_PASSWORD=
EORA_DB_AUTH_DELIVERY_PASSWORD=
EORA_DB_PROVISIONER_PASSWORD=
EORA_DB_RELAY_PASSWORD=
# Signed tenant context HMAC key kid1 (D-055): 64 hex chars (openssl rand -hex 32); loaded into the DB and the API.
EORA_CTX_KEY_KID1=
# Pepper for keyed hashes in security events (D-B1-22): 64 hex chars (openssl rand -hex 32).
EORA_PEPPER_KEY=
# Generate with: php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
EORA_APP_KEY=
EORA_DB_HOST_PORT=5432
EORA_REDIS_HOST_PORT=6380
EORA_API_HOST_PORT=8000
