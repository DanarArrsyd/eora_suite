{
    "openapi": "3.1.0",
    "info": {
        "title": "EORA Suite API",
        "version": "1.0.0-b0",
        "description": "EORA Suite API v1 (doc 24, ADR-0013). Errors are RFC 9457 problem+json; quantities are decimal strings. B0 exposes health endpoints only."
    },
    "servers": [
        {
            "url": "http://localhost:8000/api/v1",
            "description": "Same origin"
        }
    ],
    "paths": {
        "/auth/login": {
            "post": {
                "operationId": "v1.auth.login",
                "tags": [
                    "Auth"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "maxLength": 254
                                    },
                                    "password": {
                                        "type": "string",
                                        "maxLength": 1024
                                    }
                                },
                                "required": [
                                    "email",
                                    "password"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "user": {
                                            "type": "object",
                                            "properties": {
                                                "id": {
                                                    "type": "string"
                                                },
                                                "displayName": {
                                                    "type": "string"
                                                },
                                                "email": {
                                                    "type": "string"
                                                },
                                                "locale": {
                                                    "type": "string"
                                                }
                                            },
                                            "required": [
                                                "id",
                                                "displayName",
                                                "email",
                                                "locale"
                                            ]
                                        },
                                        "tenants": {
                                            "type": "array",
                                            "items": {}
                                        },
                                        "activeTenantId": {
                                            "type": [
                                                "string",
                                                "null"
                                            ]
                                        },
                                        "plants": {
                                            "type": "array",
                                            "items": {}
                                        },
                                        "activePlantId": {
                                            "type": [
                                                "string",
                                                "null"
                                            ]
                                        }
                                    },
                                    "required": [
                                        "user",
                                        "tenants",
                                        "activeTenantId",
                                        "plants",
                                        "activePlantId"
                                    ]
                                }
                            }
                        }
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        },
        "/auth/logout": {
            "post": {
                "operationId": "v1.auth.logout",
                "tags": [
                    "Auth"
                ],
                "responses": {
                    "204": {
                        "description": "No content"
                    }
                }
            }
        },
        "/auth/me": {
            "get": {
                "operationId": "v1.auth.me",
                "tags": [
                    "Auth"
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "user": {
                                            "type": "object",
                                            "properties": {
                                                "id": {
                                                    "type": "string"
                                                },
                                                "displayName": {
                                                    "type": "string"
                                                },
                                                "email": {
                                                    "type": "string"
                                                },
                                                "locale": {
                                                    "type": "string"
                                                }
                                            },
                                            "required": [
                                                "id",
                                                "displayName",
                                                "email",
                                                "locale"
                                            ]
                                        },
                                        "tenants": {
                                            "type": "array",
                                            "items": {}
                                        },
                                        "activeTenantId": {
                                            "type": [
                                                "string",
                                                "null"
                                            ]
                                        },
                                        "plants": {
                                            "type": "array",
                                            "items": {}
                                        },
                                        "activePlantId": {
                                            "type": [
                                                "string",
                                                "null"
                                            ]
                                        }
                                    },
                                    "required": [
                                        "user",
                                        "tenants",
                                        "activeTenantId",
                                        "plants",
                                        "activePlantId"
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        },
        "/auth/tenant": {
            "post": {
                "operationId": "v1.auth.tenant",
                "summary": "Tenant picker (DD-07): only a tenant where the user holds an ACTIVE membership; session regenerated",
                "tags": [
                    "Auth"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "tenantId": {
                                        "type": "string",
                                        "format": "uuid"
                                    }
                                },
                                "required": [
                                    "tenantId"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "user": {
                                            "type": "object",
                                            "properties": {
                                                "id": {
                                                    "type": "string"
                                                },
                                                "displayName": {
                                                    "type": "string"
                                                },
                                                "email": {
                                                    "type": "string"
                                                },
                                                "locale": {
                                                    "type": "string"
                                                }
                                            },
                                            "required": [
                                                "id",
                                                "displayName",
                                                "email",
                                                "locale"
                                            ]
                                        },
                                        "tenants": {
                                            "type": "array",
                                            "items": {}
                                        },
                                        "activeTenantId": {
                                            "type": [
                                                "string",
                                                "null"
                                            ]
                                        },
                                        "plants": {
                                            "type": "array",
                                            "items": {}
                                        },
                                        "activePlantId": {
                                            "type": [
                                                "string",
                                                "null"
                                            ]
                                        }
                                    },
                                    "required": [
                                        "user",
                                        "tenants",
                                        "activeTenantId",
                                        "plants",
                                        "activePlantId"
                                    ]
                                }
                            }
                        }
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    },
                    "404": {
                        "$ref": "#/components/responses/NotFoundHttpException"
                    }
                }
            }
        },
        "/auth/plant": {
            "post": {
                "operationId": "v1.auth.plant",
                "summary": "Plant switch inside the active tenant; RLS decides what exists",
                "tags": [
                    "Auth"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "plantId": {
                                        "type": "string",
                                        "format": "uuid"
                                    }
                                },
                                "required": [
                                    "plantId"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "user": {
                                            "type": "object",
                                            "properties": {
                                                "id": {
                                                    "type": "string"
                                                },
                                                "displayName": {
                                                    "type": "string"
                                                },
                                                "email": {
                                                    "type": "string"
                                                },
                                                "locale": {
                                                    "type": "string"
                                                }
                                            },
                                            "required": [
                                                "id",
                                                "displayName",
                                                "email",
                                                "locale"
                                            ]
                                        },
                                        "tenants": {
                                            "type": "array",
                                            "items": {}
                                        },
                                        "activeTenantId": {
                                            "type": [
                                                "string",
                                                "null"
                                            ]
                                        },
                                        "plants": {
                                            "type": "array",
                                            "items": {}
                                        },
                                        "activePlantId": {
                                            "type": [
                                                "string",
                                                "null"
                                            ]
                                        }
                                    },
                                    "required": [
                                        "user",
                                        "tenants",
                                        "activeTenantId",
                                        "plants",
                                        "activePlantId"
                                    ]
                                }
                            }
                        }
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    },
                    "404": {
                        "$ref": "#/components/responses/NotFoundHttpException"
                    }
                }
            }
        },
        "/auth/invitations/accept": {
            "post": {
                "operationId": "v1.auth.invitations.accept",
                "summary": "Invitation acceptance (doc 25 \u00a72.4): the delivered secret sets the first password and the membership becomes\nACTIVE (D-B1-19). Uniform failure for unknown, expired, replayed or revoked invitations",
                "tags": [
                    "Auth"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "token": {
                                        "type": "string",
                                        "pattern": "^[0-9a-f]{64}$"
                                    },
                                    "password": {
                                        "type": "string",
                                        "maxLength": 1024
                                    },
                                    "password_confirmation": {
                                        "type": "string",
                                        "maxLength": 1024
                                    }
                                },
                                "required": [
                                    "token",
                                    "password",
                                    "password_confirmation"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "204": {
                        "description": "No content"
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    }
                }
            }
        },
        "/auth/password/forgot": {
            "post": {
                "operationId": "v1.auth.password.forgot",
                "summary": "Forgot password (doc 25 \u00a72.3): always 202 with the same body after a fixed minimum duration (D-B1-21: 400 ms), so\nwhether the email exists, is throttled or was queued is not observable",
                "tags": [
                    "Auth"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "maxLength": 254
                                    }
                                },
                                "required": [
                                    "email"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "202": {
                        "description": ""
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    }
                }
            }
        },
        "/auth/password/reset": {
            "post": {
                "operationId": "v1.auth.password.reset",
                "summary": "Reset with the delivered secret (doc 25 \u00a72.3 step 3). Success bumps credential_version, so every existing session\nof the user \u2014 including this one if signed in \u2014 ends on its next request",
                "tags": [
                    "Auth"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "token": {
                                        "type": "string",
                                        "pattern": "^[0-9a-f]{64}$"
                                    },
                                    "password": {
                                        "type": "string",
                                        "maxLength": 1024
                                    },
                                    "password_confirmation": {
                                        "type": "string",
                                        "maxLength": 1024
                                    }
                                },
                                "required": [
                                    "token",
                                    "password",
                                    "password_confirmation"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "204": {
                        "description": "No content"
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    }
                }
            }
        },
        "/health": {
            "get": {
                "operationId": "v1.health.live",
                "summary": "Liveness: the application process is up",
                "tags": [
                    "Health"
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "status": {
                                            "type": "string",
                                            "const": "ok"
                                        },
                                        "service": {
                                            "type": "string"
                                        },
                                        "time": {
                                            "type": "string"
                                        }
                                    },
                                    "required": [
                                        "status",
                                        "service",
                                        "time"
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        },
        "/health/ready": {
            "get": {
                "operationId": "v1.health.ready",
                "description": "A degraded dependency is an expected answer, not an error: 503 with the same body shape and `status: degraded`.\n`version` (ok) and `error` (fail) are omitted in production.",
                "summary": "Readiness: dependencies (PostgreSQL, Redis) are reachable",
                "tags": [
                    "Health"
                ],
                "responses": {
                    "200": {
                        "description": "All dependencies are reachable.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "status": {
                                            "type": "string",
                                            "const": "ok"
                                        },
                                        "checks": {
                                            "type": "object",
                                            "properties": {
                                                "database": {
                                                    "type": "object",
                                                    "properties": {
                                                        "status": {
                                                            "type": "string",
                                                            "enum": [
                                                                "ok",
                                                                "fail"
                                                            ]
                                                        },
                                                        "latencyMs": {
                                                            "type": "number"
                                                        },
                                                        "version": {
                                                            "type": "string"
                                                        },
                                                        "error": {
                                                            "type": "string"
                                                        }
                                                    },
                                                    "required": [
                                                        "status",
                                                        "latencyMs"
                                                    ]
                                                },
                                                "redis": {
                                                    "type": "object",
                                                    "properties": {
                                                        "status": {
                                                            "type": "string",
                                                            "enum": [
                                                                "ok",
                                                                "fail"
                                                            ]
                                                        },
                                                        "latencyMs": {
                                                            "type": "number"
                                                        },
                                                        "version": {
                                                            "type": "string"
                                                        },
                                                        "error": {
                                                            "type": "string"
                                                        }
                                                    },
                                                    "required": [
                                                        "status",
                                                        "latencyMs"
                                                    ]
                                                }
                                            },
                                            "required": [
                                                "database",
                                                "redis"
                                            ]
                                        },
                                        "time": {
                                            "type": "string"
                                        }
                                    },
                                    "required": [
                                        "status",
                                        "checks",
                                        "time"
                                    ]
                                }
                            }
                        }
                    },
                    "503": {
                        "description": "At least one dependency failed; the body says which.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "status": {
                                            "type": "string",
                                            "const": "degraded"
                                        },
                                        "checks": {
                                            "type": "object",
                                            "properties": {
                                                "database": {
                                                    "type": "object",
                                                    "properties": {
                                                        "status": {
                                                            "type": "string",
                                                            "enum": [
                                                                "ok",
                                                                "fail"
                                                            ]
                                                        },
                                                        "latencyMs": {
                                                            "type": "number"
                                                        },
                                                        "version": {
                                                            "type": "string"
                                                        },
                                                        "error": {
                                                            "type": "string"
                                                        }
                                                    },
                                                    "required": [
                                                        "status",
                                                        "latencyMs"
                                                    ]
                                                },
                                                "redis": {
                                                    "type": "object",
                                                    "properties": {
                                                        "status": {
                                                            "type": "string",
                                                            "enum": [
                                                                "ok",
                                                                "fail"
                                                            ]
                                                        },
                                                        "latencyMs": {
                                                            "type": "number"
                                                        },
                                                        "version": {
                                                            "type": "string"
                                                        },
                                                        "error": {
                                                            "type": "string"
                                                        }
                                                    },
                                                    "required": [
                                                        "status",
                                                        "latencyMs"
                                                    ]
                                                }
                                            },
                                            "required": [
                                                "database",
                                                "redis"
                                            ]
                                        },
                                        "time": {
                                            "type": "string"
                                        }
                                    },
                                    "required": [
                                        "status",
                                        "checks",
                                        "time"
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "responses": {
            "ValidationException": {
                "description": "Validation error",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string",
                                    "description": "Errors overview."
                                },
                                "errors": {
                                    "type": "object",
                                    "description": "A detailed description of each field that failed validation.",
                                    "additionalProperties": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        }
                                    }
                                }
                            },
                            "required": [
                                "message",
                                "errors"
                            ]
                        }
                    }
                }
            },
            "AuthenticationException": {
                "description": "Unauthenticated",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string",
                                    "description": "Error overview."
                                }
                            },
                            "required": [
                                "message"
                            ]
                        }
                    }
                }
            },
            "NotFoundHttpException": {
                "description": "Not found",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string",
                                    "description": "Error overview."
                                }
                            },
                            "required": [
                                "message"
                            ]
                        }
                    }
                }
            }
        }
    }
}