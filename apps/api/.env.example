# EORA Suite API — local development template. Copy to .env (gitignored) and fill the secrets.
# Never commit real credentials; production values come from the secrets manager (doc 05).
APP_NAME="EORA Suite API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Structured JSON logs on stderr (use LOG_STACK=single for a local text file instead)
LOG_CHANNEL=stack
LOG_STACK=json
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL (Docker Compose service "postgres" publishes 5432 on the host)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=eora
DB_USERNAME=eora
DB_PASSWORD=
DB_CONNECT_TIMEOUT=3

# Redis via predis (no PHP extension needed). Docker Compose publishes Redis on host port 6380
# to avoid clashing with a locally installed Redis on 6379.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6380
REDIS_TIMEOUT=2

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=array
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MAIL_MAILER=log
