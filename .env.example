# Docker Compose variables for local development (copy to .env — gitignored — and fill in).
# These are LOCAL-ONLY values; never reuse them anywhere else.
EORA_DB_DATABASE=eora
EORA_DB_USERNAME=eora
EORA_DB_PASSWORD=
# Generate with: php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
EORA_APP_KEY=
EORA_DB_HOST_PORT=5432
EORA_REDIS_HOST_PORT=6380
EORA_API_HOST_PORT=8000
